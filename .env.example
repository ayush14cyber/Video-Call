# MongoDB Atlas Credentials (used by backend)
# Either provide the 4 DB parameters:
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_CLUSTER=your_cluster.mongodb.net
DB_NAME=videoConferencing

# OR provide a single full connection string:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/videoConferencing?retryWrites=true&w=majority

# Port for backend (Render assigns PORT automatically in production)
PORT=8080
