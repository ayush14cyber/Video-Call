# ==============================================================================
# FRONTEND CONFIGURATION (Set these in Vercel Project Environment Variables)
# ==============================================================================

# 1. AWS Lambda API Gateway HTTP API Endpoint (REST API)
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com
VITE_BACKEND_URL=https://YOUR_API_GATEWAY_HTTP_URL.execute-api.us-east-1.amazonaws.com

# 2. AWS API Gateway WebSocket API Endpoint (WebRTC Signaling & Real-Time Chat)
# Example: wss://def456uvw.execute-api.us-east-1.amazonaws.com/prod
VITE_WS_URL=wss://YOUR_API_GATEWAY_WS_URL.execute-api.us-east-1.amazonaws.com/prod
